# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:newpassword@localhost:5432/trade?schema=public"

# Environment
NODE_ENV="development"
PORT="3000"
API_PORT="4000"

# Security
SESSION_SECRET="your_long_random_session_secret_key_here"
CSRF_SECRET="your_long_random_csrf_secret_key_here"
COOKIE_SECURE="false"

# Private Screenshot Storage
STORAGE_PROVIDER="local" # 'local' or 's3'
UPLOAD_DIR="./uploads/screenshots"
# S3_BUCKET="trading-journal-screenshots"
# S3_REGION="us-east-1"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
